; Copy to secrets.ini (gitignored) and fill in. Read by scripts/load_secrets.py
; at build time; every key becomes a -D define consumed by include/config.h.
;
; The release env (pio run -e release) refuses to compile unless
; DP_API_KEY, DP_MQTT_USER and DP_MQTT_PASS are all set.
;
; Easiest: on the server run
;   bash scripts/provision-device.sh depok-icn-scale-01 --site depok_icn_scale
; and copy the secrets.ini it writes. Comments must be on their own line.

[secrets]
; X-API-KEY for the weighing uploads (POST /api/scavengers/save-*).
; A device key (php artisan device:api-key) - not the MQTT credential below.
DP_API_KEY =

; Broker login. The username MUST equal DP_DEVICE_ID (default
; depok-icn-scale-01): the broker ACL only lets a device publish to
; depok_icn_scale/<its own username>/...
DP_MQTT_USER =
DP_MQTT_PASS =

; Optional overrides - leave empty to keep the defaults in config.h.
DP_DEVICE_ID =
; users.id every weighing is booked on (default 3, as the old firmware).
DP_USER_ID =
DP_API_BASE_URL =
DP_MQTT_HOST =
DP_MQTT_PORT =
DP_WIFI_SSID =
DP_WIFI_PASS =
